{
  "name": "@aeonsparx/pi-unreal",
  "version": "1.0.0",
  "description": "Read-only Pi extension that resolves Unreal Engine associations and project/plugin descriptors from engine-authored schemas instead of guesswork.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aeonsparx-Interactive/pi-unreal.git"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions/unreal",
    "skills",
    "prompts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "unreal-engine",
    "pi-extension",
    "uproject",
    "uplugin"
  ],
  "pi": {
    "extensions": [
      "./extensions/unreal/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^24",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  }
}
